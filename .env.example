# Copy to .env.local for development.

# Free Bird CRM API (Laravel), including /api/v1. Server-side only.
#   local:   http://127.0.0.1:8001/api/v1   (php artisan serve --port=8001)
#   staging: https://dev-api.freebirdgym.com/api/v1
#   prod:    https://api.freebirdgym.com/api/v1
FREEBIRD_API_URL=http://127.0.0.1:8001/api/v1

# Public URL of this website (used for canonical URLs, sitemap, Open Graph).
SITE_URL=http://localhost:3000

# Shared secret with the CRM (must equal WEBSITE_SERVER_KEY in the Laravel .env). Server-side only.
WEBSITE_SERVER_KEY=

# Optional Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY in Laravel).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
